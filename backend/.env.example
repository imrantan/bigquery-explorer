# Path to a Google Cloud service account JSON key file with BigQuery read access.
# Can also be set/changed from within the app UI instead of here.
SERVICE_ACCOUNT_PATH=

# Max rows a single "Load data" request is allowed to pull from BigQuery.
MAX_ROW_LIMIT=200000

# Default row limit pre-filled in the UI.
DEFAULT_ROW_LIMIT=5000

# Origin the frontend dev server runs on (for CORS). Comma-separated for multiple.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
